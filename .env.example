SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Desenvolvimento local (Docker Compose) ---
# Usado apenas quando DATABASE_URL não está definida.
DB_NAME=aulacerta
DB_USER=aulacerta
DB_PASSWORD=aulacerta
DB_HOST=db
DB_PORT=5432

# --- Produção (Render) ---
# Se DATABASE_URL estiver definida, ela tem prioridade sobre as
# variáveis DB_* acima. No Render, essa variável é preenchida
# automaticamente ao conectar o banco PostgreSQL ao Web Service
# (ou pelo render.yaml, se você usar o deploy via Blueprint).
# DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco
